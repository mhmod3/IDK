# متغيرات البيئة المطلوبة لنشر Cloudflare Pages
# انسخ هذا الملف إلى `.env` أو عيّن القيم مباشرةً في Cloudflare Pages Dashboard.

# هدف البناء — استخدم "pages" لبناء نسخة ثابتة قابلة للنشر على Cloudflare Pages.
DEPLOY_TARGET=pages

# تعطيل تلمتر Next.js لتسريع البناء.
NEXT_TELEMETRY_DISABLED=1

# ---- أسرار النشر (تُضبط في Cloudflare Pages Dashboard > Settings > Environment variables) ----
# CLOUDFLARE_API_TOKEN       رمز وصول Cloudflare بصلاحية "Cloudflare Pages: Edit".
# CLOUDFLARE_ACCOUNT_ID      معرّف الحساب في Cloudflare.
# CLOUDFLARE_PAGES_PROJECT   اسم المشروع على Cloudflare Pages (افتراضي: idk-free-fall).
